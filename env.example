# FRP Configuration
FRP_SERVER_ADDR=your_vps_ip_here
FRP_SERVER_PORT=45413
FRP_TOKEN=your_frp_token_here

# Dynamic Port Configuration
DYNAMIC_PORT_SECRET=your_shared_secret_here
DYNAMIC_BASE_PORT=30000
DYNAMIC_PORT_RANGE=1000
DYNAMIC_PORT_INTERVAL=300

# JWT Secret for token signing
JWT_SECRET=6501f8b546a3aae74886b80558c0902fde2bb7fa76169cb49d12711c288682d9

# Tunnel Configuration
MAX_TUNNEL_SECONDS=3600
STALL_TIMEOUT_SECONDS=300

# Grace period for token expiration (helps with WhatsApp link previews)
# This adds extra time beyond the requested expiration to allow link previews without consuming the token
GRACE_PERIOD_SECONDS=3600

# Redis Configuration (optional, defaults work for docker-compose)
# REDIS_URL=redis://redis:6379 